{
	"name": "slides-notebook",
	"displayName": "Slides Notebook",
	"description": "Opens the markdown of a slides-rs deck as a notebook, runs its code cells as the deck does, and saves their outputs where the deck reads them.",
	"version": "0.1.0",
	"publisher": "maurosilber",
	"license": "MIT",
	"private": true,
	"engines": {
		"vscode": "^1.88.0"
	},
	"categories": [
		"Notebooks"
	],
	"extensionDependencies": [
		"ms-vscode.wasm-wasi-core"
	],
	"activationEvents": [
		"onLanguage:markdown",
		"onLanguage:slides",
		"workspaceContains:**/*.md"
	],
	"main": "./dist/extension.js",
	"browser": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "slides",
				"aliases": [
					"Slides Markdown",
					"slides"
				],
				"filenamePatterns": [
					"*.slides.md"
				],
				"configuration": "./language/language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "slides",
				"scopeName": "text.html.markdown.slides",
				"path": "./language/slides.tmLanguage.json"
			}
		],
		"notebooks": [
			{
				"type": "slides-notebook",
				"displayName": "Slides Notebook",
				"priority": "option",
				"selector": [
					{
						"filenamePattern": "*.md"
					}
				]
			}
		],
		"commands": [
			{
				"command": "slides.openNotebook",
				"title": "Open as Slides Notebook",
				"category": "Slides",
				"icon": "$(notebook)"
			},
			{
				"command": "slides.restartKernel",
				"title": "Restart Kernel",
				"category": "Slides",
				"icon": "$(debug-restart)",
				"enablement": "!isWeb"
			},
			{
				"command": "slides.showSlides",
				"title": "Show Slides",
				"category": "Slides",
				"icon": "$(play)",
				"enablement": "!isWeb"
			},
			{
				"command": "slides.newSlide",
				"title": "New Slide",
				"category": "Slides",
				"icon": "$(add)"
			},
			{
				"command": "slides.moveSlideUp",
				"title": "Move Slide Up",
				"category": "Slides",
				"icon": "$(arrow-up)"
			},
			{
				"command": "slides.moveSlideDown",
				"title": "Move Slide Down",
				"category": "Slides",
				"icon": "$(arrow-down)"
			},
			{
				"command": "slides.moveSlideTo",
				"title": "Move Slide To…",
				"category": "Slides",
				"icon": "$(list-ordered)"
			},
			{
				"command": "slides.stopSlides",
				"title": "Stop Rendering Slides",
				"category": "Slides",
				"enablement": "!isWeb"
			}
		],
		"colors": [
			{
				"id": "slides.slideBreak",
				"description": "The background of the line where a slide of a deck's markdown begins: its rule, or an import.",
				"defaults": {
					"dark": "#3794ff26",
					"light": "#0066bf1a",
					"highContrast": "#ffffff26",
					"highContrastLight": "#0000001a"
				}
			}
		],
		"notebookRenderer": [
			{
				"id": "slides-figure",
				"displayName": "Slides Figure",
				"entrypoint": "./dist/renderer.js",
				"mimeTypes": [
					"application/vnd.slides-rs.svg+xml"
				],
				"requiresMessaging": "optional"
			}
		],
		"configuration": {
			"title": "Slides Notebook",
			"properties": {
				"slides.pythonServer": {
					"type": "string",
					"default": "",
					"markdownDescription": "The Python language server for the code cells in the markdown text editor, started in the environment they run in: a command, such as `basedpyright-langserver`, `ty` or `pyright-langserver`, or its path. Empty, the first of those in that environment or on the `PATH`. `off`, or with none found, the cells are completed by the Python language server VS Code has, with no diagnostics, hovers or definitions."
				},
				"slides.path": {
					"type": "string",
					"default": "",
					"markdownDescription": "The `slides-rs` command, which runs the code cells with `slides-rs kernel`. Empty, the one that comes with the extension, or else `slides-rs` on the `PATH`."
				}
			}
		},
		"menus": {
			"editor/title": [
				{
					"command": "slides.openNotebook",
					"when": "(resourceLangId == slides || resourceLangId == markdown && resourcePath in slides.decks) && activeEditor == workbench.editors.files.textFileEditor",
					"group": "navigation"
				},
				{
					"command": "slides.showSlides",
					"when": "(resourceLangId == slides || resourceLangId == markdown && resourcePath in slides.decks) && !isWeb",
					"group": "navigation"
				}
			],
			"notebook/toolbar": [
				{
					"command": "slides.restartKernel",
					"when": "notebookType == slides-notebook && !isWeb",
					"group": "navigation/execute"
				},
				{
					"command": "slides.showSlides",
					"when": "notebookType == slides-notebook && !isWeb",
					"group": "navigation"
				}
			],
			"commandPalette": [
				{
					"command": "slides.newSlide",
					"when": "(resourceLangId == slides || resourceLangId == markdown && resourcePath in slides.decks) && editorTextFocus"
				},
				{
					"command": "slides.moveSlideUp",
					"when": "(resourceLangId == slides || resourceLangId == markdown && resourcePath in slides.decks) && editorTextFocus"
				},
				{
					"command": "slides.moveSlideDown",
					"when": "(resourceLangId == slides || resourceLangId == markdown && resourcePath in slides.decks) && editorTextFocus"
				},
				{
					"command": "slides.moveSlideTo",
					"when": "(resourceLangId == slides || resourceLangId == markdown && resourcePath in slides.decks) && editorTextFocus"
				},
				{
					"command": "slides.restartKernel",
					"when": "notebookType == slides-notebook && !isWeb"
				},
				{
					"command": "slides.showSlides",
					"when": "(resourceLangId == slides || resourceLangId == markdown && resourcePath in slides.decks || notebookType == slides-notebook) && !isWeb"
				},
				{
					"command": "slides.stopSlides",
					"when": "!isWeb"
				}
			],
			"explorer/context": [
				{
					"command": "slides.openNotebook",
					"when": "(resourceLangId == slides || resourceLangId == markdown && resourcePath in slides.decks)",
					"group": "navigation"
				},
				{
					"command": "slides.showSlides",
					"when": "(resourceLangId == slides || resourceLangId == markdown && resourcePath in slides.decks) && !isWeb",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"build:wasm": "cargo build --package slides-notebook --release --target wasm32-wasip1-threads && node -e \"require('fs').mkdirSync('dist',{recursive:true});require('fs').copyFileSync('../target/wasm32-wasip1-threads/release/slides-notebook.wasm','dist/slides-notebook.wasm')\"",
		"build:ts": "tsc --noEmit && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node:* --external:child_process --external:crypto --external:fs --external:net --external:os --external:path --external:util --format=cjs --platform=neutral --main-fields=module,main --target=es2022 --sourcemap && esbuild src/renderer.ts --bundle --outfile=dist/renderer.js --format=esm --target=es2022 --sourcemap",
		"build:cli": "cargo build --bin slides-rs --release && node -e \"require('fs').mkdirSync('dist',{recursive:true});require('fs').copyFileSync('../target/release/slides-rs','dist/slides-rs');require('fs').chmodSync('dist/slides-rs',0o755)\"",
		"build": "npm run build:wasm && npm run build:cli && npm run build:ts",
		"test": "node test/run.mjs",
		"package": "vsce package --no-dependencies --no-rewrite-relative-links --allow-missing-repository --skip-license"
	},
	"dependencies": {
		"@vscode/wasm-wasi": "^1.0.1",
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "~1.88.0",
		"@types/vscode-notebook-renderer": "^1.72.4",
		"@vscode/test-electron": "^2.4.1",
		"@vscode/vsce": "^3.2.1",
		"esbuild": "^0.25.0",
		"typescript": "^5.6.0"
	}
}
